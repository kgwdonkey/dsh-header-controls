{
  "name": "dsh-header-controls",
  "description": "会话右上角电源控制：Session log 左侧的「重启 / 注销」胶囊按钮，与官方版式一致（静态 web 插件）",
  "version": "0.1.6",
  "origin": "self-made",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kgwdonkey/dsh-header-controls.git"
  },
  "homepage": "https://github.com/kgwdonkey/dsh-header-controls",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "restart",
    "power-control"
  ],
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
